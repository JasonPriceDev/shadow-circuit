{
  "name": "Shadow Circuit",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],
  "remoteUser": "node",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly"
  ],
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "./scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vizards.deepseek-v4-for-copilot"
      ],
      "settings": {
        "deepseek-copilot.baseUrl": "https://api.deepseek.com",
        "deepseek-copilot.maxTokens": 0,
        "z-models.openrouter.apiKey": "${env:OPENROUTER_API_KEY}",
        "github.copilot.advanced.openAiApiKey": "${env:OPENAI_API_KEY}",
        // "chat.defaultModel": "GPT-5.6 Terra (openai)", 
        // "chat.exploreAgent.defaultModel": "GPT-5.6 Terra (openai)",
        // "github.copilot.selectedCompletionModel": "GPT-5.6 Terra (openai)",
        // "inlineChat.defaultModel": "GPT-5.6 Terra (openai)",
        // "chat.utilitySmallModel": "openai/gpt-5.6-luna",
        "workbench.browser.enableChatTools": true,
        "chat.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "chat.exploreAgent.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "github.copilot.selectedCompletionModel": "DeepSeek V4 Pro (deepseek)",
        "inlineChat.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "chat.utilitySmallModel": "deepseek/deepseek-v4-flash",

      }

    }
  }
  
}
