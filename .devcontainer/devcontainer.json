{
  "name": "Shadow Circuit",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.12"
    }
  },
  "remoteUser": "node",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash ./scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "vizards.deepseek-v4-for-copilot"
      ],
      "settings": {
        "deepseek-copilot.baseUrl": "https://api.deepseek.com",
        "deepseek-copilot.maxTokens": 16384,
        "deepseek-copilot.debugMode": "minimal",
        "workbench.browser.enableChatTools": true,
        "chat.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "chat.exploreAgent.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "github.copilot.selectedCompletionModel": "DeepSeek V4 Pro (deepseek)",
        "inlineChat.defaultModel": "DeepSeek V4 Pro (deepseek)",
        "chat.utilitySmallModel": "deepseek/deepseek-v4-flash",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
